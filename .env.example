# LifeOS Production Environment Configuration Template

# Environment & Application Name
ENVIRONMENT="production"
APP_NAME="LifeOS Health Analytics Platform"

# Security & JWT Token Auth
SECRET_KEY="generate-a-secure-random-32-character-secret-key-here"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (SQLite or PostgreSQL)
DATABASE_URL="sqlite:///./lifeos.db"
# DATABASE_URL="postgresql://user:password@hostname:5432/lifeos_db"

# Allowed CORS Origins (Comma separated URLs)
CORS_ORIGINS="http://localhost:3000,https://lifeos-app.vercel.app"

# AI RAG Assistant Integration
GEMINI_API_KEY="your-gemini-api-key-here"

# Model Directory Path
ML_MODEL_DIR="./models"
