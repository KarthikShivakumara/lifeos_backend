# LIFEOS PRODUCTION BACKEND ENVIRONMENT CONFIGURATION
ENVIRONMENT=production
APP_NAME="LifeOS API"

# Database Connection String (PostgreSQL)
DATABASE_URL=postgresql://lifeos_user:super_secure_postgres_password_2026@postgres_db:5432/lifeos_prod_db

# Security & Secrets (Must be at least 32 characters)
SECRET_KEY=e83f90a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Production CORS Allowed Origins (Comma separated, NO WILDCARDS)
CORS_ORIGINS=https://lifeos.health,https://www.lifeos.health

# Model Artifact Directory
ML_MODEL_DIR=./models

# External AI / LLM Keys
GEMINI_API_KEY=your-production-gemini-api-key
OPENAI_API_KEY=your-production-openai-api-key

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
